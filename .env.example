DATABASE_URL=postgresql://user:password@127.0.0.1:5432/n_back
INTEGRATION_ENCRYPTION_KEY=change-me-32-char-random-string
AUTH_JWT_SECRET=change-me-32-char-random-string
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:3000/auth/github/callback
FRONTEND_URL=http://localhost:5183
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_EMAIL_PROVIDER=resend
PUBLIC_API_URL=http://127.0.0.1:3000
AUTH_DEFAULT_LOGIN_PROVIDER=github
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
INTERNAL_SYNC_TOKEN=change-me-32-char-random-string
DATABASE_POOL_MAX=20
# IDs numéricos do GitHub (não username) autorizados a logar como gestor do SaaS, separados por vírgula.
PLATFORM_OPERATOR_GITHUB_IDS=
# Prefixo das rotas do gestor do SaaS (com barra no início, ex: /xyz123-ops) — escolha um valor não-óbvio, nunca "admin"/"ops"/"internal". Sem isso configurado, as rotas não existem.
PLATFORM_ADMIN_ROUTE_PREFIX=
